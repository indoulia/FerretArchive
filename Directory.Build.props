<Project>

  <!--
    Directory.Build.props — applied to every project in the repository.
    Override per-project in a local <Project>.props file if needed.
  -->

  <PropertyGroup Label="Product">
    <Product>Ferret</Product>
    <Company>Ferret Contributors</Company>
    <Copyright>Copyright © 2026 Ferret Contributors</Copyright>
    <Authors>Ferret Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/indoulia/Ferret</PackageProjectUrl>
    <RepositoryUrl>https://github.com/indoulia/Ferret</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <!-- CI overrides via /p:VersionPrefix=X.Y.Z and /p:VersionSuffix=<prerelease>.
         These feed only the semantic version (Version / InformationalVersion /
         NuGet package version). AssemblyVersion and FileVersion are pinned to
         1.0.0.0 for a stable binary identity that never moves with the release
         version (and so a prerelease label can never break the build). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Label="Target Framework">
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Label="Analysis">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <Deterministic>true</Deterministic>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- CS1591: missing XML comment — relaxed in non-library projects -->
  </PropertyGroup>

  <PropertyGroup Label="Test">
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.IntegrationTests'))">true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Label="NuGet symbol packages">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Suppress XML doc warning only in test projects -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Label="Analysers">
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="Global usings for test projects">
    <Using Include="Xunit" Condition="'$(IsTestProject)' == 'true'" />
  </ItemGroup>

  <ItemGroup Label="StyleCop settings — explicit link so all projects pick up the repo-root config">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

</Project>
